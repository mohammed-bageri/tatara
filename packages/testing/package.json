{
	"name": "@tatara/testing",
	"version": "0.2.0",
	"description": "tatara test helpers: in-process API client, per-worker databases and Redis dbs, fast cleanup",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"ioredis": "^6.0.0",
		"pg": "^8.23.1"
	},
	"peerDependenciesMeta": {
		"ioredis": {
			"optional": true
		},
		"pg": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tatara/http": "workspace:^",
		"@types/pg": "8.23.1",
		"hono": "^4.13.13",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/testing"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	}
}
