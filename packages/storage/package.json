{
	"name": "@tatara/storage",
	"version": "0.3.1",
	"description": "tatara storage: a Storage contract with local, S3 and GCS drivers, upload keys, validation and orphan reconciliation",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./s3": {
			"types": "./dist/s3.d.mts",
			"import": "./dist/s3.mjs"
		},
		"./gcs": {
			"types": "./dist/gcs.d.mts",
			"import": "./dist/gcs.mjs"
		},
		"./commands": {
			"types": "./dist/commands.d.mts",
			"import": "./dist/commands.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/s3-request-presigner": "^3.1152.0",
		"@google-cloud/storage": "^7.19.0",
		"@tatara/core": "^0.2.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/s3-request-presigner": "^3.1152.0",
		"@google-cloud/storage": "^7.22.0",
		"@tatara/core": "workspace:^",
		"zod": "^4.6.7"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara.git",
		"directory": "packages/storage"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara/issues"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"@aws-sdk/s3-request-presigner": {
			"optional": true
		},
		"@google-cloud/storage": {
			"optional": true
		}
	},
	"tatara": {
		"commands": [
			{
				"import": "@tatara/storage/commands",
				"factory": "storageCommands",
				"args": {
					"storage": "#core/storage/index"
				}
			}
		]
	}
}
