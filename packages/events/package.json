{
	"name": "@tatara/events",
	"version": "0.1.2",
	"description": "tatara events: a transactional domain-event outbox with per-subscriber deliveries, retries, reconcile and prune, over an app-owned store",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./drizzle": {
			"types": "./dist/drizzle.d.mts",
			"import": "./dist/drizzle.mjs"
		},
		"./commands": {
			"types": "./dist/commands.d.mts",
			"import": "./dist/commands.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@tatara/core": "^0.2.1",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@tatara/core": "workspace:^",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7",
		"pino": "^10.4.0",
		"pg": "^8.23.1",
		"@types/pg": "8.23.1"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara.git",
		"directory": "packages/events"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara/issues"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		}
	},
	"tatara": {
		"commands": [
			{
				"import": "@tatara/events/commands",
				"factory": "eventsCommands",
				"args": {
					"events": "#modules/events/services/events"
				}
			}
		]
	}
}
